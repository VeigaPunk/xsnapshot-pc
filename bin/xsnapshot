#!/bin/bash -p
set -euo pipefail
# Privileged mode suppresses imported functions and Bash startup hooks; it does
# not grant privileges. Refuse a mismatched identity rather than retaining one.
if [[ "$EUID" != "$UID" ]]; then
  builtin printf '%s\n' 'xsnapshot refuses mismatched real/effective user identities' >&2
  exit 2
fi
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
[[ "$SCRIPT_DIR" != "${BASH_SOURCE[0]}" ]] || SCRIPT_DIR=.
ROOT="$(builtin cd -- "$SCRIPT_DIR/.." && builtin pwd -P)"
# Use the system interpreter, never a user PATH shim or startup site hook.
exec /usr/bin/python3 -I -S "$ROOT/lib/xsnapshot.py" --root "$ROOT" "$@"
